---
import { getCollection, getEntry, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReviewCard from '../../components/ReviewCard.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { categorySlug } from '../../lib/categories';
import { categoryStyle } from '../../lib/categoryStyle';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  const byCategory = new Map<string, typeof reviews>();
  for (const r of reviews) {
    const list = byCategory.get(r.data.category) ?? [];
    list.push(r);
    byCategory.set(r.data.category, list);
  }
  return [...byCategory.entries()].map(([name, list]) => ({
    params: { category: categorySlug(name) },
    props: {
      name,
      list: list.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
    },
  }));
}

const { name, list } = Astro.props;
const st = categoryStyle(name);
// 選び方の手引きと比較表(src/content/categories/<slug>.md)。無いカテゴリはビルドで止める
const guide = await getEntry('categories', categorySlug(name));
if (!guide) throw new Error(`src/content/categories/${categorySlug(name)}.md がありません(カテゴリ「${name}」)`);
const { Content } = await render(guide);
const intro = guide.data.summary;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${name}のAIツール`,
  description: intro,
  mainEntity: {
    '@type': 'ItemList',
    numberOfItems: list.length,
    itemListElement: list.map((r, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: r.data.title,
      url: new URL(`/reviews/${r.id}/`, Astro.site).toString(),
    })),
  },
};
---
<BaseLayout title={`${name}のAIツールの選び方と比較(${list.length}件)`} description={`${intro}記事${list.length}件の要点を、選び方の手引きと比較表にまとめています。`} jsonLd={jsonLd} wide>
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <ol>
      <li><a href="/">ホーム</a></li>
      <li><a href="/categories/">カテゴリ一覧</a></li>
      <li aria-current="page">{name}</li>
    </ol>
  </nav>
  <header class="cat-hero" style={`--cat: ${st.color}`}>
    <span class="cat-hero-icon"><CategoryIcon name={st.icon} size={34} /></span>
    <div>
      <h1>{name}</h1>
      <p>{intro}</p>
      <p class="cat-hero-count">{list.length}件の記事</p>
    </div>
  </header>

  <article class="prose cat-guide">
    <Content />
  </article>

  <h2 class="section-title">{name}の記事({list.length}件)</h2>
  <div class="card-grid">
    {list.map((r) => <ReviewCard review={r} headingLevel={3} showCategory={false} />)}
  </div>

  <p class="back-link"><a href="/">&larr; すべての記事を見る</a></p>
</BaseLayout>
