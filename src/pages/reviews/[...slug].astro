---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import AdSlot from '../../components/AdSlot.astro';
import RelatedReviews from '../../components/RelatedReviews.astro';
import { categoryPath } from '../../lib/categories';
import { extractFaq } from '../../lib/faq';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((review) => ({
    params: { slug: review.id },
    props: { review, allReviews: reviews },
  }));
}

const { review, allReviews } = Astro.props;
const { Content } = await render(review);

const pageUrl = new URL(`/reviews/${review.id}/`, Astro.site).toString();
const publisher = {
  '@type': 'Organization',
  name: 'AI Tool Lab',
  url: new URL('/', Astro.site).toString(),
};

const articleLd = {
  '@type': 'Article',
  headline: review.data.title,
  description: review.data.description,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  inLanguage: 'ja',
  datePublished: review.data.pubDate.toISOString(),
  ...(review.data.updatedDate && { dateModified: review.data.updatedDate.toISOString() }),
  articleSection: review.data.category,
  keywords: review.data.tags.join(', '),
  author: publisher,
  publisher,
};

// パンくず。検索結果に階層が出るようにする(画面上のリンクはカテゴリタグが担う)
const breadcrumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: review.data.category, item: new URL(categoryPath(review.data.category), Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: review.data.title, item: pageUrl },
  ],
};

// 本文に「よくある質問」があればFAQPageも出す
const faq = extractFaq(review.body ?? '');
const faqLd = faq.length > 0
  ? {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': faqLd ? [articleLd, breadcrumbLd, faqLd] : [articleLd, breadcrumbLd],
};
---
<BaseLayout title={review.data.seoTitle ?? review.data.title} description={review.data.description} jsonLd={jsonLd}>
  <p class="meta">
    <a class="tag" href={categoryPath(review.data.category)}>{review.data.category}</a>
    {review.data.pubDate.toLocaleDateString('ja-JP')}
  </p>
  <h1>{review.data.title}</h1>

  {review.data.affiliateDisclosure && <AffiliateDisclosure />}

  <article>
    <Content />
  </article>

  <AdSlot label="記事下広告" />

  <RelatedReviews current={review} allReviews={allReviews} />

  <p><a href="/">&larr; 一覧に戻る</a></p>
</BaseLayout>
