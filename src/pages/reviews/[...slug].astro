---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AffiliateDisclosure from '../../components/AffiliateDisclosure.astro';
import AdSlot from '../../components/AdSlot.astro';
import RelatedReviews from '../../components/RelatedReviews.astro';
import Toc from '../../components/Toc.astro';
import CategoryIcon from '../../components/CategoryIcon.astro';
import { categoryStyle } from '../../lib/categoryStyle';
import { formatDate, isoDate, readingMinutes } from '../../lib/articleMeta';
import { categoryPath } from '../../lib/categories';
import { extractFaq } from '../../lib/faq';

export async function getStaticPaths() {
  const reviews = await getCollection('reviews');
  return reviews.map((review) => ({
    params: { slug: review.id },
    props: { review, allReviews: reviews },
  }));
}

const { review, allReviews } = Astro.props;
const { Content, headings } = await render(review);
const catStyle = categoryStyle(review.data.category);
const minutes = readingMinutes(review.body ?? '');

// 本文に広告ボックスがある記事は、冒頭の広告表記を「含みます」と言い切る形にする
const hasAds = (review.body ?? '').includes('class="affiliate-box"');

const jstIso = (d: Date) => `${isoDate(d)}T00:00:00+09:00`;
const pageUrl = new URL(`/reviews/${review.id}/`, Astro.site).toString();
const publisher = {
  '@type': 'Organization',
  name: 'AI Tool Lab',
  url: new URL('/', Astro.site).toString(),
};

const articleLd = {
  '@type': 'Article',
  headline: review.data.title,
  description: review.data.description,
  url: pageUrl,
  mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
  inLanguage: 'ja',
  image: new URL('/og-default.png', Astro.site).toString(),
  // 日付は日本時間の0時として出す(サイトマップの lastmod と同じ基準)
  datePublished: jstIso(review.data.pubDate),
  ...(review.data.updatedDate && { dateModified: jstIso(review.data.updatedDate) }),
  articleSection: review.data.category,
  keywords: review.data.tags.join(', '),
  author: publisher,
  publisher,
};

// パンくず。検索結果に階層が出るようにする(画面にも同じ階層を出している)
const breadcrumbLd = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'ホーム', item: new URL('/', Astro.site).toString() },
    { '@type': 'ListItem', position: 2, name: review.data.category, item: new URL(categoryPath(review.data.category), Astro.site).toString() },
    { '@type': 'ListItem', position: 3, name: review.data.title, item: pageUrl },
  ],
};

// 本文に「よくある質問」があればFAQPageも出す
const faq = extractFaq(review.body ?? '');
const faqLd = faq.length > 0
  ? {
      '@type': 'FAQPage',
      mainEntity: faq.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': faqLd ? [articleLd, breadcrumbLd, faqLd] : [articleLd, breadcrumbLd],
};
---
<BaseLayout
  title={review.data.seoTitle ?? review.data.title}
  description={review.data.description}
  jsonLd={jsonLd}
  article={{
    publishedTime: jstIso(review.data.pubDate),
    modifiedTime: review.data.updatedDate && jstIso(review.data.updatedDate),
  }}
>
  <nav class="breadcrumb" aria-label="パンくずリスト">
    <ol>
      <li><a href="/">ホーム</a></li>
      <li><a href={categoryPath(review.data.category)}>{review.data.category}</a></li>
      <li aria-current="page">{review.data.title}</li>
    </ol>
  </nav>

  <header class="article-header">
    <p class="article-cat">
      <a class="cat-pill" href={categoryPath(review.data.category)} style={`--cat: ${catStyle.color}`}>
        <CategoryIcon name={catStyle.icon} size={16} />{review.data.category}
      </a>
    </p>
    <h1>{review.data.title}</h1>
    <ul class="article-meta">
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><rect x="3" y="5" width="18" height="16" rx="2"/><path d="M3 10h18M8 3v4M16 3v4"/></svg>
        公開 <time datetime={isoDate(review.data.pubDate)}>{formatDate(review.data.pubDate)}</time>
      </li>
      {review.data.updatedDate && (
        <li>
          <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 11a8 8 0 1 0-2.3 5.7"/><path d="M20 4v7h-7"/></svg>
          更新 <time datetime={isoDate(review.data.updatedDate)}>{formatDate(review.data.updatedDate)}</time>
        </li>
      )}
      <li>
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
        読了の目安 約{minutes}分
      </li>
    </ul>
  </header>

  {review.data.affiliateDisclosure && <AffiliateDisclosure hasAds={hasAds} />}

  <Toc headings={headings} />

  <article class="prose">
    <Content />
  </article>

  <AdSlot label="記事下広告" />

  <RelatedReviews current={review} allReviews={allReviews} />

  <p class="back-link"><a href={categoryPath(review.data.category)}>&larr; {review.data.category}の記事一覧</a> ・ <a href="/">ホームへ</a></p>
</BaseLayout>
