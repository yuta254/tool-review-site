---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import AdSlot from '../components/AdSlot.astro';
import ReviewCard from '../components/ReviewCard.astro';
import CategoryIcon from '../components/CategoryIcon.astro';
import { categoryPath } from '../lib/categories';
import { categoryStyle } from '../lib/categoryStyle';

const all = (await getCollection('reviews')).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// 「ガイド」はツール単体のレビューではないので、入口として先に見せる
const guides = all.filter((r) => r.data.category === 'ガイド');
const reviews = all.filter((r) => r.data.category !== 'ガイド');

const counts = new Map<string, number>();
for (const r of reviews) {
  counts.set(r.data.category, (counts.get(r.data.category) ?? 0) + 1);
}
const categoryTotal = new Set(all.map((r) => r.data.category)).size;
const categories = [...counts.entries()].sort((a, b) => b[1] - a[1] || a[0].localeCompare(b[0], 'ja'));
---
<BaseLayout title="AI Tool Lab" description="AIツール・ソフトウェアの料金・機能・違いを公式情報で整理する比較サイト" wide>
  <section class="hero">
    <svg class="hero-deco" viewBox="0 0 400 200" aria-hidden="true" focusable="false">
      <circle cx="330" cy="40" r="90" fill="currentColor" opacity=".08"/>
      <circle cx="380" cy="170" r="60" fill="currentColor" opacity=".08"/>
      <path d="M250 70 l9 24 24 9 -24 9 -9 24 -9-24 -24-9 24-9z" fill="currentColor" opacity=".22"/>
      <path d="M352 118 l5 13 13 5 -13 5 -5 13 -5-13 -13-5 13-5z" fill="currentColor" opacity=".3"/>
    </svg>
    <p class="hero-eyebrow">AIツールの比較・料金ガイド</p>
    <h1>AI Tool Lab</h1>
    <p class="hero-lead">AIツール・ソフトウェアの料金・機能・違いを、仕事でどう使い分けるかという視点で比較しています。料金と機能は公式情報で確認しています。</p>
    <ul class="hero-stats">
      <li><strong>{all.length}</strong>本の記事</li>
      <li><strong>{categoryTotal}</strong>カテゴリ</li>
      <li><a href="/tools/">無料ツールを見る</a></li>
    </ul>
  </section>

  <AdSlot label="トップページ広告" />

  <section class="home-section">
    <h2 class="section-title">カテゴリから探す</h2>
    <ul class="chip-list">
      {categories.map(([name, count]) => {
        const st = categoryStyle(name);
        return (
          <li>
            <a href={categoryPath(name)} style={`--cat: ${st.color}`}>
              <CategoryIcon name={st.icon} size={16} />{name}<span class="count">{count}</span>
            </a>
          </li>
        );
      })}
    </ul>
    <p class="more-link"><a href="/categories/">カテゴリ一覧を見る &rarr;</a></p>
  </section>

  {guides.length > 0 && (
    <section class="home-section">
      <h2 class="section-title">選ぶ前に読むガイド</h2>
      <div class="card-grid">
        {guides.map((r) => <ReviewCard review={r} />)}
      </div>
    </section>
  )}

  <section class="home-section">
    <h2 class="section-title">レビュー・比較記事</h2>
    <div class="card-grid">
      {reviews.map((review) => <ReviewCard review={review} />)}
    </div>
  </section>
</BaseLayout>
