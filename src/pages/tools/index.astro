---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 2026-11-22: AIツールと関係の薄い汎用ツール11本(BMI・積立・単位変換・QR・パスワード・文字ケース・Base64・JSON・Markdown・文字数・割引)を外した。
// 旧URLは public/_redirects でこの一覧へ301。残す6本は、記事の主題(AIの料金・AI画像の印刷・動画の容量)とつながるもの。
const groups = [
  {
    heading: 'AIのAPIとプロンプト',
    tools: [
      { href: '/tools/ai-api-cost-calculator/', title: 'AI API料金計算ツール', desc: 'OpenAI・Anthropic・Google のAPIの料金を、入力・出力のトークン数と月の呼び出し回数から概算します(公式単価・2026年11月3日確認)。' },
      { href: '/tools/token-counter/', title: 'AIトークン数カウンター(概算)', desc: '貼り付けた文章を日本語の文字とそれ以外に分けて、おおよそのトークン数を出します。' },
      { href: '/tools/ai-api-cost-tracker/', title: 'AI APIコスト管理・予算アラートツール', desc: 'APIに使った金額を記録し、今月の合計を月の予算と比べます。記録はブラウザの中だけに保存します。' },
      { href: '/tools/prompt-builder/', title: 'AIプロンプト作成ツール', desc: 'やりたいこと・トーン・出力形式を選んで、AIチャットに貼り付ける指示の文を組み立てます。' },
    ],
  },
  {
    heading: '画像と動画',
    tools: [
      { href: '/tools/image-size-checker/', title: '画像サイズ・印刷解像度チェッカー', desc: '画像のピクセル数から、何cmまで印刷できるかと、目標の幅に足りるかを計算します。アップロードは行いません。' },
      { href: '/tools/video-size-calculator/', title: '動画ファイルサイズ計算ツール', desc: 'ビットレートと再生時間からファイルサイズを概算し、容量の上限に収める映像ビットレートを逆算します。' },
    ],
  },
];
---
<BaseLayout title="無料ツール一覧" description="AI APIの料金の概算・トークン数の目安・API費用の記録・プロンプトの組み立て・AI画像の印刷解像度・動画の容量の計算ができる、ブラウザだけで動く無料ツール6本の一覧です。">
  <h1>無料ツール</h1>
  <p>記事で扱っている「AIの料金」「AIで作った画像の印刷」「動画の容量」の計算を、ブラウザだけで行えるツールです。登録やインストールは要りません。入力した値や画像はどこにも送信されません。各ツールのページに、計算式と前提、関係する記事を書いています。</p>

  {groups.map((g) => (
    <section>
      <h2>{g.heading}</h2>
      <div class="card-list">
        {g.tools.map((tool) => (
          <article class="card">
            <h3><a href={tool.href}>{tool.title}</a></h3>
            <p>{tool.desc}</p>
          </article>
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
