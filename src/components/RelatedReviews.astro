---
import type { CollectionEntry } from 'astro:content';
import ReviewCard from './ReviewCard.astro';

interface Props {
  current: CollectionEntry<'reviews'>;
  allReviews: CollectionEntry<'reviews'>[];
}

const { current, allReviews } = Astro.props;

const related = allReviews
  .filter((r) => r.id !== current.id && r.data.category === current.data.category)
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 4);
---

{related.length > 0 && (
  <section class="related-reviews">
    <h2 class="section-title">関連記事</h2>
    <div class="card-grid card-grid-2">
      {related.map((r) => <ReviewCard review={r} />)}
    </div>
  </section>
)}
